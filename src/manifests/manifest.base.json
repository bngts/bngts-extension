{
  "manifest_version": 3,
  "name": "방통실 Plus - 치지직 & SOOP 로그인 연동",
  "short_name": "방통실 Plus",
  "version": "3.2.8",
  "description": "방통실(bngts.com) 멀티뷰에서 치지직·SOOP 로그인을 자동 연동하고 플레이어를 최적화합니다. 스트리머 즐겨찾기, 방송 알림 기능을 제공합니다.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "homepage_url": "https://bngts.com/",
  "permissions": [
    "activeTab",
    "alarms",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "*://*.naver.com/*",
    "*://*.sooplive.com/*",
    "*://*.mul.live/*",
    "*://*.bngts.com/*",
    "*://ocean-archive.pages.dev/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "js": [
        "playback-status-model.js",
        "playback-status-ui.js",
        "bngts-status.js"
      ],
      "matches": [
        "*://*.bngts.com/*",
        "http://localhost/*"
      ],
      "run_at": "document_start"
    },
    {
      "all_frames": true,
      "js": ["playback-status-main-model.js", "soop-playback-main.js"],
      "matches": ["https://play.sooplive.com/*", "https://vod.sooplive.com/player/*"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "all_frames": true,
      "js": ["playback-status-model.js", "soop-playback-isolated.js"],
      "matches": ["https://play.sooplive.com/*", "https://vod.sooplive.com/player/*"],
      "run_at": "document_start"
    },
    {
      "all_frames": true,
      "js": [
        "chzzk.js"
      ],
      "matches": [
        "*://chzzk.naver.com/*"
      ],
      "world": "MAIN"
    },
    {
      "all_frames": true,
      "js": [
        "soop.js"
      ],
      "matches": [
        "*://play.sooplive.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "all_frames": true,
      "js": [
        "soop-isolated.js"
      ],
      "matches": [
        "*://play.sooplive.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "all_frames": true,
      "js": [
        "chzzk-isolated.js"
      ],
      "matches": [
        "*://chzzk.naver.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["playback-status.css", "brand/soop.svg", "brand/chzzk.png"],
    "matches": ["https://bngts.com/*", "https://www.bngts.com/*", "http://localhost/*"]
  }],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
